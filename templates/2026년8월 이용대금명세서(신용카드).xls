                                    <th scope="col" id="h6-c1" headers="a6">원금</th>
                                    <th scope="col" id="h6-c2" headers="a6">수수료<br>(이자)</th>
                                </tr>
                                </thead>
                                <tbody data-bind-each="loanArr"></tbody>
                                <tfoot>
                                <tr data-bind-visible="visibleLoan" style="display: none;">
                                    <th scope="row" colspan="5" id="hr1">합계</th>
                                    <td headers="h6 h6-c1 hr1"><strong data-bind-text="use_amt_sum"></strong></td>
                                    <td headers="h6 h6-c2 hr1"><strong data-bind-text="use_fee_sum"></strong></td>
                                    <td headers="h7 hr1"><strong data-bind-text="use_af_sum"></strong></td>
                                </tr>
                                <tr data-bind-visible="!visibleLoan" style="">
                                    <th colspan="8">장기카드대출 이용내역이 없습니다.</th>
                                </tr>
                                </tfoot>
                            </table>
                        </td>
                    </tr>
                </tbody></table>
                <br>
                <br>
                <table border="1">
                    <tbody><tr>
