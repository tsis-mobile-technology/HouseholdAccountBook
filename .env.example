# HouseholdAccountBook 환경 설정 예시
# 복사하여 .env 파일로 저장 후 필요한 값을 설정하세요.

# [기본 서버 설정]
# HOST=0.0.0.0
# PORT=8000

# [HTTPS / SSL 설정]
# 보유하고 계신 인증서 파일(.pem, .crt)과 개인키 파일(.key, .pem)의 절대 경로 또는 상대 경로를 입력하세요.
# 예:
# SSL_CERTFILE=certs/cert.pem
# SSL_KEYFILE=certs/key.pem

# 개인키에 암호가 걸려있는 경우 입력 (없으면 비워두거나 주석 처리)
# SSL_KEYFILE_PASSWORD=

# (참고) SSL_CERTFILE, SSL_KEYFILE을 별도로 지정하지 않고
# 프로젝트 루트의 certs/ 폴더에 cert.pem (또는 fullchain.pem)과
# key.pem (또는 privkey.pem)을 넣어두시면 자동으로 감지하여 HTTPS로 구동됩니다.
